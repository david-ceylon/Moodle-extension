{
  "manifest_version": 3,
  "name": "Moodle+",
  "short_name": "Moodle+",
  "description": "Toutes les nouveautés de votre Moodle (fichiers, dossiers, annonces, notes, échéances) dans une interface claire.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Moodle+",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "webRequest",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "https://moodle.jct.ac.il/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
