{
  "name": "moodle-plus",
  "productName": "Moodle+",
  "version": "1.0.0",
  "description": "Moodle+ : se connecte à Moodle (SSO + double authentification) et affiche toutes les nouveautés dans une interface moderne — extension Chrome, appli Android, web-app et application de bureau (Mac/Linux).",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js && node scripts/serve-web.js",
    "build:extension": "node scripts/build-extension.js"
  },
  "author": "David",
  "license": "MIT",
  "dependencies": {
    "htm": "^3.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "build": {
    "appId": "fr.moodleplus.app",
    "productName": "Moodle Plus",
    "files": [
      "src/main/**/*",
      "src/preload.js",
      "src/renderer/**/*",
      "node_modules/htm/**/*",
      "node_modules/qrcode/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "syncDesktopName": true
    },
    "artifactName": "Moodle-Plus-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    }
  },
  "desktopName": "moodle-plus.desktop"
}
